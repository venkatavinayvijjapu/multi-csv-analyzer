from typing import Any, Dict, List, Optional, Union
from langchain_core.callbacks import CallbackManagerForToolRun
from langchain_core.tools import BaseTool
import pandas as pd
import requests
import streamlit as st
from pydantic import BaseModel, ConfigDict
import base64
import os
import re


def _safe_var_name(filename: str) -> str:
    base = os.path.splitext(filename)[0]
    safe = re.sub(r"[^a-zA-Z0-9_]", "_", base)
    if safe and safe[0].isdigit():
        safe = "df_" + safe
    return safe or "df"


class DataAnalysisAPIWrapper(BaseModel):
    api_url: str = "http://127.0.0.1:8000"
    model_config = ConfigDict(extra="forbid")

    def _analyze(self, dfs: Dict[str, pd.DataFrame], query: str) -> str:
        """Encode all DataFrames and send to FastAPI /analyze endpoint."""
        try:
            files_payload = []
            for name, df in dfs.items():
                data_b64 = base64.b64encode(
                    df.to_csv(index=False).encode("utf-8")
                ).decode("utf-8")
                files_payload.append({"name": name, "data_base64": data_b64})

            payload = {"files": files_payload, "query": query}
            response = requests.post(f"{self.api_url}/analyze", json=payload, timeout=60)

            if response.status_code == 200:
                result = response.json().get("result", "No analysis result returned.")
                return result + "\n\n✅ Analysis complete."
            else:
                return (
                    f"❌ Analysis failed.\n"
                    f"Status: {response.status_code}\n"
                    f"Message: {response.text[:300]}"
                )
        except Exception as e:
            return f"❌ API request failed: {e}"

    def run(self, inputs: Union[str, Dict[str, Any]]) -> str:
        if isinstance(inputs, str):
            inputs = {"input": inputs}
        elif not isinstance(inputs, dict):
            return "❌ Invalid input type: expected string or dict."

        query = inputs.get("input") or inputs.get("query") or ""
        dfs: Dict[str, pd.DataFrame] = st.session_state.get("dataframes", {})

        if not dfs:
            return "❌ No datasets found in session. Please upload files first."

        return self._analyze(dfs, query)


class DataAnalysisTool(BaseTool):
    name: str = "data_analysis_tool"
    description: str = (
        "Performs data analysis across one or more uploaded datasets. "
        "Input should be a string with the analysis question. "
        "Handles totals, averages, filters, comparisons, and trends across all uploaded files."
    )
    api_wrapper: DataAnalysisAPIWrapper

    def _run(
        self,
        *args,
        run_manager: Optional[CallbackManagerForToolRun] = None,
        **kwargs,
    ) -> str:
        query = None
        if "input" in kwargs:
            query = kwargs["input"]
        elif args:
            query = str(args[0])
        elif "kwargs" in kwargs and isinstance(kwargs["kwargs"], dict):
            query = kwargs["kwargs"].get("input")

        if not query:
            return "❌ Error: No valid input query found. Please provide a natural language question."

        return self.api_wrapper.run({"input": query})
