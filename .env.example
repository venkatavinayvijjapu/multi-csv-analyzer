# Darwinbox DataLens AI - Environment Variables
# Copy this file to .env and fill in your values

# ── LLM Provider (ExperientialLabs) ──────────────────────────────────────────
EXPLABS_API_KEY=your_experientiallabs_api_key_here
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-5.6-luna

# ── Fallback LLM Provider (Groq) ─────────────────────────────────────────────
# Used if EXPLABS_API_KEY is not set
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Session Management ────────────────────────────────────────────────────────
# How long sessions live without activity (seconds). Default: 7200 (2 hours)
SESSION_TTL_SECONDS=7200

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_SESSION=20
MAX_ROWS_PER_FILE=500000

# ── Code Execution ────────────────────────────────────────────────────────────
# Timeout for LLM-generated code execution (seconds). Default: 30
QUERY_TIMEOUT_SECONDS=30
# Number of retries on code execution failure. Default: 2
MAX_RETRIES=2

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO
LOG_LEVEL=INFO
